[importlinter]
root_packages =
    config
    src

[importlinter:contract:core-independence]
name = core не импортирует функциональные модули
type = forbidden
source_modules =
    src.core
forbidden_modules =
    src.sales
    src.production
    src.quality
    src.supply
    src.timesheet
    src.equipment
    src.energy
    src.analytics

# Фасадные контракты — про прямой импорт: чужой модуль обращается к `facade.py`, а сам
# фасад импортирует свои `selectors`/`services` (как в ИС, ADR 0031 ИС, решение 10).
[importlinter:contract:facade-sales]
name = Только facade.py даёт доступ к src.sales
type = forbidden
source_modules =
    src.production
    src.quality
    src.supply
    src.timesheet
    src.equipment
    src.energy
    src.analytics
forbidden_modules =
    src.sales.models
    src.sales.services
    src.sales.selectors
allow_indirect_imports = True

[importlinter:contract:facade-production]
name = Только facade.py даёт доступ к src.production
type = forbidden
source_modules =
    src.sales
    src.quality
    src.supply
    src.timesheet
    src.equipment
    src.energy
    src.analytics
forbidden_modules =
