[importlinter:contract:core-layers]
name = Слои внутри ядра
type = layers
layers =
    src.core.notifications
    src.core.documents
    src.core.numbering
    src.core.accounts
    src.core.org
    src.core.identity
    src.core.events
    src.core.common
    src.core.audit
