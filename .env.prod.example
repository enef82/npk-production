# Шаблон переменных для docker-compose.prod.yml (docs/adr/0029-prod-kontur.md).
# Реальный .env НЕ коммитится (см. .gitignore), на сервере — права 600.
#
# Две категории строк:
#   KEY=            — обязательно заполнить, у настройки нет безопасного значения по
#                      умолчанию для прода (либо секрет, либо публичный адрес системы).
#   # KEY=значение  — необязательно, показан для видимости; без этой строки Django
#                      сам берёт то же значение по умолчанию (config/settings/base.py
#                      или production.py). Раскомментируй только если нужно другое.
#
# ВНИМАНИЕ: строка вида KEY= (пустое значение) — это не «не задано», это «задано
# пустой строкой». Для параметров из второй категории пустая строка может сломать
# парсинг (env.int("") — исключение, не откат к default), поэтому они закомментированы
# целиком, а не оставлены пустыми.

# --- Django -------------------------------------------------------------------

# Всегда config.settings.production на этой машине.
DJANGO_SETTINGS_MODULE=

# Один раз, не переносится между окружениями. НЕ через get_random_secret_key()
# как есть — её алфавит включает `$`, а docker compose интерпретирует `$` в .env
# как начало подстановки другой переменной и молча обрезает хвост значения
# (проверено эмпирически при первой выкатке 18.09 — SECRET_KEY обрывался посреди
# строки без единой ошибки). Сгенерировать без `$`:
#   python -c "
#   from django.utils.crypto import get_random_string
#   import string
#   print(get_random_string(50, allowed_chars=string.ascii_letters + string.digits + '!@#%^&*()-_=+'))
#   "
SECRET_KEY=

# Домен системы, без схемы и порта. Один — ee3.kt96.ru, без www и без схемы.
ALLOWED_HOSTS=

# Тот же домен со схемой https:// — без него форма входа отклоняется CSRF-проверкой
# ещё до входа в view.
CSRF_TRUSTED_ORIGINS=

# HSTS начинается с часа (config/settings/production.py) и поднимается только после
# того, как всё заработало на бою — раскомментируй и подними, когда будешь готов.
# Год — 31536000. preload и includeSubDomains не включать (см. ADR 0030).
# SECURE_HSTS_SECONDS=3600

# Ограничение частоты попыток входа (ADR 0030, мера 1) — блокировка по связке
# «учётная запись + адрес». Порог попыток и окно блокировки в часах — значения
# по умолчанию (5 попыток, 1 час) не решение заказчика, только разумный старт.
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_TIME_HOURS=1.0

# --- PostgreSQL -----------------------------------------------------------------

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# psql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB> — хост всегда
# `postgres` (имя сервиса в docker-сети), не localhost и не публичный адрес.
DATABASE_URL=

# --- Redis ------------------------------------------------------------------

# redis://redis:6379/0 — хост всегда `redis`.
REDIS_URL=

# --- MinIO (S3) ---------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Бакет по умолчанию — npk-prod, обычно не нужно менять.
# AWS_STORAGE_BUCKET_NAME=npk-prod

# Обязательно http://minio:9000 — внутреннее docker-имя. MinIO наружу не публикуется
# (docs/adr/0029-prod-kontur.md, п. 1) — публичный домен здесь означал бы, что
# presigned-ссылки снова текут в браузер напрямую, чего эта правка и убирала.
AWS_S3_ENDPOINT_URL=

# Регион по умолчанию — ru-central1 (Yandex Object Storage), для MinIO не важен,
# но должен быть непустым (boto3 требует). Обычно не нужно менять.
# AWS_S3_REGION_NAME=ru-central1

# --- Gotenberg ----------------------------------------------------------------

# http://gotenberg:3000 — внутреннее docker-имя, порт наружу не публикуется (это
# и значение по умолчанию, менять обычно не нужно).
# GOTENBERG_URL=http://gotenberg:3000

# --- Caddy / сертификат --------------------------------------------------------

# Домен системы для сертификата, без схемы. Тот же, что в ALLOWED_HOSTS.
SITE_ADDRESS=

# Локальная проверка HTTPS-контура на машине разработчика (часть D задания) — не
# переменная окружения: положить файл docker/caddy/tls-local.d/tls.conf с
# содержимым `tls internal`, каталог пуст и в .gitignore, никогда не коммитится
# и не появляется на сервере. Пустой/несуществующий каталог Caddyfile просто
# импортирует без ошибки (предупреждение в логе) — боевой Let's Encrypt (HTTP-01)
# работает по умолчанию, без этого файла.

# --- Разное -----------------------------------------------------------------

# Секунд до истечения временной ссылки на файл — метаданные ответа API, не срок
# годности самой ссылки (docs/adr/0029-prod-kontur.md, п. 1: право проверяется на
# каждый запрос байтов, а не по этому сроку). 900 подходит почти всегда.
# DOCUMENTS_URL_TTL_SECONDS=900
