# Сгенерированные артефакты — всегда LF, чтобы `make api-diff` не срабатывал на
# переводах строк при перегенерации на Windows (core.autocrlf=true).
openapi.json text eol=lf
frontend/lib/api/*.ts text eol=lf

# Документация пишется в Linux-сессии (LF) и правится на Windows (core.autocrlf=true).
# Без явного eol=lf каждая доставка .md-файла давала бы дифф на всех строках сразу.
*.md text eol=lf

# DOCX-шаблоны (генерация КП, шаг 10) и XLSX-нормативы (загрузка норм, шаги 11–12) —
# это zip-архивы, а не текст: без пометки git на Windows применил бы к ним конвертацию
# переводов строк и разрушил бы контейнер.
*.docx binary
*.xlsx binary
