DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-to-a-random-secret-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=npk_prod
POSTGRES_USER=npk_prod
POSTGRES_PASSWORD=npk_prod
# Порт постгреса на хосте. Если 5432 занят (нативный PostgreSQL, другой docker-compose и т.п.),
# смени здесь и в DATABASE_URL на свободный порт.
POSTGRES_HOST_PORT=5432
DATABASE_URL=psql://npk_prod:npk_prod@localhost:5432/npk_prod

REDIS_URL=redis://localhost:6379/0

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=npk-prod
# localhost — для uv run (make test, make lint) на хосте. Контейнеры web/worker/beat
# получают адрес до minio по имени сервиса через environment: в docker-compose.yml.
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=ru-central1

DOCUMENTS_URL_TTL_SECONDS=900
# Тот же принцип: с хоста Gotenberg смотрит на localhost, контейнеры — на имя сервиса.
GOTENBERG_URL=http://localhost:3000
