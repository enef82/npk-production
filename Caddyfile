# Прод-контур (docs/adr/0029-prod-kontur.md). Одна программа — веб-сервер, обратный
# прокси и получатель сертификата; отдельный nginx/Apache не нужен.
#
# Email для уведомлений Let's Encrypt — литералом, не через переменную окружения:
# Caddyfile не даёт директиве `email` необязательного аргумента (пустая подстановка
# `{$VAR}` не схлопывается в ноль токенов — проверено эмпирически, `email {$CADDY_EMAIL}`
# без значения роняет Caddy в рестарт-луп с ошибкой парсинга). Без адреса — один
# из немногих сигналов, что продление сертификата сломалось, теряется молча при
# отсутствии отдельного мониторинга.
{
	email enef@mail.ru
}

{$SITE_ADDRESS} {
	# HTTP-01 зафиксирован явно, tls-alpn-01 отключён — не оптимизация, а фиксация
	# единственной схемы, которая когда-либо срабатывала на этой сети (18.09).
	# Caddy по умолчанию сам выбирает и переключает тип challenge; после первого
	# успеха на http-01 он перешёл на tls-alpn-01 и с тех пор ни разу не получил
	# сертификат — рабочая гипотеза: ACME-сессия идёт по одному HTTP/2-соединению
	# (Caddy держит его между шагами, в отличие от одиночных проверочных запросов,
	# которые каждый раз открывают новое), а tls-alpn-01 перед шагом «готов»
	# генерирует валидационный сертификат и поднимает обработчик на 443 — эта
	# пауза, в отличие от мгновенной записи токена у http-01, достаточна, чтобы
	# NAT-шлюз офисной сети сбросил простаивающий поток без RST, и клиент
	# зависает в ожидании заголовков до таймаута. Проверяемое следствие: на
	# http-01 (короткая пауза) выпуск проходит, что и наблюдалось на staging.
	# Явный `issuer acme` НЕ наследует глобальный `email` (в отличие от неявной
	# автоматической конфигурации) — без дублирования здесь адрес в ACME-аккаунте
	# молча потеряется, и уведомления об истечении сертификата останутся
	# ненастроенными без единого сигнала об этом.
	tls {
		issuer acme {
			email enef@mail.ru
			disable_tlsalpn_challenge
		}
	}

	# Пусто и в этом репозитории, и на сервере — только для локальной проверки
	# `tls internal` (часть D задания), см. .env.prod.example. Одновременно с
	# явным `issuer acme` выше не используется: для локального прогона `tls`
	# из этого файла временно закомментировать.
	import tls-local.d/*.conf

	# Редирект с :80 на :443 — встроенное поведение Caddy для доменного адреса,
	# отдельно не описывается. Второго входа на 80 не остаётся: ничего, кроме
	# редиректа, этот блок не обслуживает на порту 80.

	# Статика Django (admin/unfold) — общий том с `web`/`migrate` (collectstatic),
	# отдаёт сам Caddy: файлы публичные, дополнительная проверка прав не нужна.
	handle_path /static/* {
		root * /srv/static
		file_server
	}

	# Медиа (вложения, КП) Caddy не раздаёт вовсе — их отдаёт сам Django через
	# /api/v1/documents/{id}/download с проверкой прав на каждый запрос
	# (docs/adr/0029-prod-kontur.md, п. 1). MinIO в этом файле не упоминается ни
	# разу — наружу он не публикуется и не проксируется.

	handle /api/* {
		reverse_proxy web:8000
	}

	handle /admin/* {
		reverse_proxy web:8000
	}

	handle /healthz {
		reverse_proxy web:8000
	}

	# Всё остальное — Next.js. /admin и /api/docs здесь не выделены отдельно:
	# заказчик отклонил ограничение по адресам офисной сети (docs/adr/0030-
	# publikatsiya-v-internet.md), оба доступны наравне с приложением.
	handle {
		reverse_proxy frontend:3001
	}
}
